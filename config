# 字体
font-family = "Maple Mono NF CN SemiBold"
font-family = "JetBrains Maple Mono"
font-family = "LXGW WenKai GB Screen"
font-size = 9

# 行为
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false

# 着色器
custom-shader-animation = always
custom-shader = "~/.config/ghostty/shaders/cursor_smear.glsl"
custom-shader = "~/.config/ghostty/shaders/cursor_pulse.glsl"

# 主题
theme = dankcolors
background-opacity = 0.85
background-blur = 0
window-padding-x = 5
window-padding-y = 5
window-decoration = false

# 光标
cursor-style = block
cursor-style-blink = true

# 按键
keybind = ctrl+j=scroll_page_up
keybind = ctrl+k=scroll_page_down
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:2
keybind = ctrl+minus=decrease_font_size:2
keybind = ctrl+zero=reset_font_size
